# ───── Aplicación y bot de Discord ─────
# Token del bot (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=reemplaza_con_el_token_de_tu_bot
# ID de la aplicación (Developer Portal → General Information)
CLIENT_ID=reemplaza_con_el_id_de_tu_aplicacion
# ID(s) de los dueños del bot, separados por coma
OWNER_IDS=reemplaza_con_tu_id_de_usuario_de_discord
# ID del servidor de soporte (opcional; se usa para registrar comandos si SLASH_GLOBAL=false)
SUPPORT_GUILD_ID=

# ───── Comportamiento ─────
# true = comandos globales | false = solo en SUPPORT_GUILD_ID
SLASH_GLOBAL=true
# Registrar en el canal de logs cada comando ejecutado
COMMAND_LOGS=true
# Registrar los slash commands al iniciar (mejor usar `npm run deploy` cuando cambien los comandos)
AUTO_DEPLOY=false
# Habilita /eval (código arbitrario, SOLO para dueños). Déjalo en false si no lo necesitas
ENABLE_EVAL=false
# Idioma por defecto: en | es | pt
DEFAULT_LANGUAGE=es

# ───── Base de datos SQLite ─────
DATABASE_PATH=./data/akame.sqlite

# ───── Enlaces (opcionales) ─────
SUPPORT_URL=
# Si se deja vacío, se genera con CLIENT_ID
BOT_INVITE_URL=
BOT_INVITE_PERMISSIONS=534723820736

# ───── Canales de logs (opcionales, IDs) ─────
# Los que queden vacíos usan LOG_CHANNEL_ID
LOG_CHANNEL_ID=
SERVER_LOG_CHANNEL_ID=
COMMAND_LOG_CHANNEL_ID=
ERROR_LOG_CHANNEL_ID=
REPORT_CHANNEL_ID=
BUG_CHANNEL_ID=
SUGGESTION_CHANNEL_ID=